#!/usr/bin/env bash
# Start the beamkit MCP stdio server from a CVMFS release.
#
# Register in .mcp.json as
#   {"mcpServers": {"beamkit": {"command":
#     "/cvmfs/mu2e.opensciencegrid.org/bin/beamkit/current/scripts/beamkit-mcp-cvmfs"}}}
#
# The release ships its own .venv (mcp, requests, authlib, htcondor). The
# Fermilab path also needs prodtools importable: BEAMKIT_PRODTOOLS_ROOT
# (default: the cvmfs prodtools `current` release) goes on PYTHONPATH
# together with its mcp/src, after the Mu2e ops environment is set up
# for samweb and jobsub. The NERSC path uses none of that but the same
# process serves both, so the setup always runs.
# All setup output goes to stderr: stdout is the JSON-RPC channel.
set -euo pipefail

BEAMKIT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PYTHON_BIN="$BEAMKIT_ROOT/.venv/bin/python"
[[ -x "$PYTHON_BIN" ]] || { echo "beamkit: no venv at $BEAMKIT_ROOT/.venv (install_beamkit.sh builds it)" >&2; exit 1; }
BEAMKIT_PRODTOOLS_ROOT="${BEAMKIT_PRODTOOLS_ROOT:-/cvmfs/mu2e.opensciencegrid.org/bin/prodtools/current}"
[[ -d "$BEAMKIT_PRODTOOLS_ROOT/mcp/src" ]] || { echo "beamkit: $BEAMKIT_PRODTOOLS_ROOT has no mcp/src (set BEAMKIT_PRODTOOLS_ROOT)" >&2; exit 1; }
export BEAMKIT_PRODTOOLS_ROOT

# CVMFS setup scripts are not set -e clean; guard around them.
set +u
if [[ $- == *e* ]]; then _restore_e=1; set +e; else _restore_e=0; fi
source /cvmfs/mu2e.opensciencegrid.org/setupmu2e-art.sh 1>&2
_rc=$?
if [[ ${_restore_e} -eq 1 ]]; then set -e; fi
if [[ ${_rc} -ne 0 ]]; then echo "beamkit: setupmu2e-art.sh failed ($_rc)" >&2; exit ${_rc}; fi
muse setup ops 1>&2
set -u
MU2E_OPS_PYTHONPATH="${PYTHONPATH:-}"

# Order matters: venv first, then prodtools' mcp/src (prodtools_mcp_write),
# then the prodtools root (utils.*), then the ops env.
VENV_SITE="$("$PYTHON_BIN" -c 'import site; print([p for p in site.getsitepackages() if "site-packages" in p][0])')"
PP="$VENV_SITE:$BEAMKIT_PRODTOOLS_ROOT/mcp/src:$BEAMKIT_PRODTOOLS_ROOT"
[[ -n "$MU2E_OPS_PYTHONPATH" ]] && PP="$PP:$MU2E_OPS_PYTHONPATH"
export PYTHONPATH="$PP"

if [[ "${1:-}" == "--check" ]]; then
  "$PYTHON_BIN" - <<'PY'
import asyncio, sys
from beamkit.server import create_mcp_server, TOOL_NAMES
from beamkit import bridge
registered = sorted(t.name for t in asyncio.run(create_mcp_server().list_tools()))
if registered != sorted(TOOL_NAMES):
    raise SystemExit(f"tool registration mismatch: {registered} != {sorted(TOOL_NAMES)}")
info = bridge.prodtools_info()
print("OK: interpreter", sys.executable)
print("OK: tools", ", ".join(registered))
print("OK: prodtools", info["root"], info["commit"])
PY
  exit 0
fi

exec "$PYTHON_BIN" -m beamkit.server
